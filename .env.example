# Copy this file to .env and fill in your API keys.
# Run: ./run.sh  (Linux)   or   .\run.ps1  (Windows)

# ── LLM: Gemma 3 27B via Google AI Studio (free, 14,400 req/day) ──────────────
# Get a free API key at: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemma-3-27b-it
LLM_API_KEY=your-gemma-3-27b-it-api-key-here
# ── Whisper: Groq API (free tier, no GPU required) ───────────────────────────
# Get a free API key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=data/articulate.db
AUDIO_DIR=data/audio
PRONUNCIATION_TIER=1
MAX_AUDIO_SIZE_MB=500
AUDIO_RETENTION_DAYS=90

# ── Alternatives (uncomment to use) ───────────────────────────────────────────
# Gemini Flash — higher quality, stricter 20 req/day limit:
# LLM_MODEL=gemini-2.5-flash
#
# Groq LLM — Llama 3.3 70B, very fast, generous free tier:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your-groq-api-key-here
