PROFILE=gemini

# ── LLM: Gemma 3 27B via Google AI Studio (free, 14,400 req/day) ──────────────
# Get a free API key at: https://aistudio.google.com/apikey
OLLAMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OLLAMA_MODEL=gemma-3-27b-it
LLM_API_KEY=your-google-ai-studio-api-key-here

# ── Whisper: local GPU (fast ~2s, quality large-v3) ───────────────────────────
# GPU used only for transcription (~2s burst). LLM runs via API — no GPU burn.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=data/articulate.db
AUDIO_DIR=data/audio
OLLAMA_GPU_LAYERS=0
PRONUNCIATION_TIER=1
MAX_AUDIO_SIZE_MB=500
AUDIO_RETENTION_DAYS=90

# ── Alternatives (uncomment to use) ───────────────────────────────────────────
# Higher quality LLM, stricter 20 req/day limit:
# OLLAMA_MODEL=gemini-2.5-flash
#
# Groq — Llama 3.3 70B, very fast, generous free tier (https://console.groq.com):
# OLLAMA_BASE_URL=https://api.groq.com/openai/v1
# OLLAMA_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your-groq-api-key-here
